{
  "realm": "global-exchange",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "admin", "description": "Administrador del sistema" },
      { "name": "operador", "description": "Operador de mesa de cambio" },
      { "name": "supervisor", "description": "Supervisor de operaciones" },
      { "name": "empleado", "description": "Empleado interno" },
      { "name": "cliente", "description": "Cliente autoregistrado" }
    ]
  },
  "defaultRole": {
    "name": "default-roles-global-exchange",
    "composite": true,
    "composites": {
      "realm": ["cliente"]
    }
  },
  "clients": [
    {
      "clientId": "django-app",
      "name": "Global Exchange - Django",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_IN_ENV",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/oidc/callback/"
      ],
      "webOrigins": [
        "http://localhost:8000"
      ],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "realm-roles-in-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.demo",
      "email": "admin.demo@globalexchange.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carlos",
      "lastName": "González",
      "credentials": [
        { "type": "password", "value": "Admin123!", "temporary": true }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "operador.demo",
      "email": "operador.demo@globalexchange.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Jorge",
      "lastName": "Ramírez",
      "credentials": [
        { "type": "password", "value": "Operador123!", "temporary": true }
      ],
      "realmRoles": ["operador"]
    }
  ]
}
