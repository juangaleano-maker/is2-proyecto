# --- Seguridad y Django Core ---
DEBUG=False
SECRET_KEY=django-prod-sec-key-$(2026)-is2-global-exchange-super-secret-production-random-hash
ALLOWED_HOSTS=localhost,127.0.0.1,*
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80
APP_BASE_URL=http://localhost

# --- Base de Datos Principal (PostgreSQL) ---
DB_NAME=global_exchange_prod
DB_USER=postgres
DB_PASSWORD=prod_secure_password_2026
DB_HOST=db-prod
DB_PORT=5432

# --- Redis & Celery ---
REDIS_URL=redis://redis-prod:6379/1
USE_REDIS_CACHE=True
CELERY_BROKER_URL=redis://redis-prod:6379/0
CELERY_RESULT_BACKEND=redis://redis-prod:6379/0

# --- Keycloak Identity Provider (SSO) ---
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_SERVER_URL=http://keycloak-prod:8080
KEYCLOAK_REALM=global-exchange
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_prod_password
OIDC_RP_CLIENT_ID=django-app
OIDC_RP_CLIENT_SECRET=maie fyxm kzlx tyur

# --- Notificaciones por Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
